<div class="row ps-0 me-0">
    <nav class="navbar navbar-expand-lg navbar-light bg-light" style="background-color: white !important;">
        <div class="container-fluid ps-0" style="margin-left: 2rem;">
            <div class="row">
                {{#if navbar.menu_icon}}
                <div class="col-auto my-auto" id="nav-menu">
                    <div class="side_nav_bar">
                        <button class="btn btn-light" type="button" id="lsidebar-button">
                            <i class="{{navbar.menu_icon}}"></i>
                        </button>
                    </div>
                </div>
                {{/if}}

                <div class="col-auto">
                    <div class="logo">
                        <a class="navbar-brand" href="/homepage">
                            <img src="{{navbar.logo}}" class="img-fluid" width="150" height="auto" />
                        </a>
                    </div>
                </div>

                {{#if navbar.homepage}}
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    {{#each navbar.nav_items as |navValue navKey|}}
                    <ul class="navbar-nav pt-3">
                        <li class="nav-item ps-5">
                            <a class="nav-link target" href="{{navValue}}">
                                <div class="fs-4 mb-3">
                                    <i class="bi bi-currency-dollar pl-0">{{navKey}}</i>
                                </div>
                            </a>
                        </li>
                    </ul>
                    {{/each}}
                </div>
                {{/if}}

                {{#if navbar.logged}}

                <div class="col d-flex align-items-center h-100 my-auto"
                    style="background-color: #e7e7e7;margin-left: 0 !important;">
                    <i class="{{navbar.search_box}}"></i>
                    <input class="form-control" type="text" id="global-search" oninput="" placeholder="Buscar"
                        style="background-color: #e7e7e7; border-radius: 0; border-width: 0;">
                </div>

                <div class="col dropdown">
                    <a href="#" class="d-flex align-items-center link-dark text-decoration-none dropdown-toggle"
                        id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="/img/guillermo.jpg" alt="" width="42" height="42" class="rounded-circle">
                    </a>
                    <ul class="dropdown-menu text-small shadow" aria-labelledby="dropdownUser">
                        <li><a class="dropdown-item" href="#">Configuración</a></li>
                        <li><a class="dropdown-item" href="#">Mi cuenta</a></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item" href="/logout">Cerrar Sesión</a></li>
                    </ul>
                </div>

                {{/if}}

            </div>
    </nav>

</div>