<div class="row ps-0 me-0 pb-4">
    <nav class="navbar navbar-expand-lg navbar-light bg-light" style="background-color: white !important;">
        <div class="container-fluid ps-0" style="margin-left: 2rem;">

            {{#if navbar.menu_icon}}
            <div class="my-auto pe-4" id="nav-menu">
                <div class="side_nav_bar">
                    <button class="btn btn-light" type="button" id="lsidebar-button">
                        <i class="{{navbar.menu_icon}}"></i>
                    </button>
                </div>
            </div>
            {{/if}}

            <div class="{{navbar.logo.space}}" id="logo">
                <a class="navbar-brand" href="{{navbar.logo.link}}">
                    <img src="{{navbar.logo.src}}" class="img-fluid" width="150" height="auto" />
                </a>
            </div>

            {{#if navbar.homepage}}
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse ps-2" id="navbarNav">
                <ul class="navbar-nav pt-3">
                    {{#each navbar.nav_items as |navValue navKey|}}
                    <li class="nav-item {{navValue.space}}">
                        <a class="nav-link target" href="{{navValue.link}}">
                            <div class="fs-4 mb-3">
                                <i class="{{navValue.icon}} pl-1">{{navKey}}</i>
                            </div>
                        </a>
                    </li>
                    {{/each}}
                </ul>
            </div>

            <div class="ms-auto" id="enterPage">
                <div class="row">
                    <div class="col-lg-6 col-md-2">
                        <form action="/signin">
                            <input type="submit" value="Iniciar Sesión" class="btn btn-outline-secondary" />
                        </form>
                    </div>
                    <div class="col">
                        <form action="/signup">
                            <input type="submit" value="Registrarse" class="btn btn-primary" />
                        </form>
                    </div>
                </div>
            </div>
            {{/if}}

            {{#if navbar.logged}}
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse ps-2" id="navbarNav">
                <ul class="navbar-nav w-100" style="margin-right: 1rem">
                    <li class="nav-item my-auto w-50">
                        <div class="d-flex align-items-center h-100 my-auto"
                            style="background-color: #e7e7e7;margin-left: 0 !important;">
                            <i class="{{navbar.search_box}} ps-2 pe-1"></i>
                            <input class="form-control" type="text" id="global-search" oninput="" placeholder="Buscar"
                                style="background-color: #e7e7e7; border-radius: 0; border-width: 0;">
                        </div>
                    </li>
                    {{#each navbar.nav_items as |navValue navKey|}}
                    <li class="nav-item {{navValue.space}}">
                        <a class="nav-link target" href="{{navValue.link}}">
                            <div class="fs-3">
                                <i class="{{navValue.icon}} pl-0"></i>
                            </div>
                        </a>
                    </li>
                    {{/each}}

                </ul>
            </div>


            <div class="dropdown" style="margin-right: 3rem;">
                <a href="#" class="d-flex align-items-center link-dark text-decoration-none dropdown-toggle"
                    id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="/img/guillermo.jpg" alt="" width="42" height="42" class="rounded-circle">
                </a>
                <ul class="dropdown-menu text-small shadow" aria-labelledby="dropdownUser">
                    <li><a class="dropdown-item" href="#">Configuración</a></li>
                    <li><a class="dropdown-item" href="#">Mi cuenta</a></li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li><a class="dropdown-item" href="/logout">Cerrar Sesión</a></li>
                </ul>
            </div>

            {{/if}}

        </div>
    </nav>
</div>