
{{#each plans}}
<div class="container-plans">
    <div class="container-fluid">
        <div class="container">
            <div class="text-center opensans" style="margin-top: 2vw;padding-bottom: 2vw; color: #0b375ad9;">
                <h2>
                    {{@key}}
                </h2>
            </div>
            <div class="row">
                {{#each this}}
                <div class="col-lg-4 col-md-12 mb-4">
                    <div class="card h-100 w-100 shadow-lg">
                        <div class="card-header {{css-clase}}">
                            <div class="text-center pt-3">
                                <span class="h2">${{precio}}</span>/{{re_write_month meses}}
                            </div>
                        </div>
                        <div class="card-body ps-5 pe-5">
                            <ul class="list-group list-group-flush">
                                {{#each beneficios}}
                                <li class="list-group-item ps-0 pe-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check" viewBox="0 0 16 16">
                                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                                    </svg> {{this}}
                                </li>
                                {{/each}}
                            </ul>
                        </div>
                        <div class="card-footer text-center">
                            <button class="btn btn-outline btn-{{css-clase}} w-100 btn-pay">Comprar</button>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>
{{/each}}


<script type="text/javascript">
    
    const buttons = document.querySelectorAll('.btn-pay');

    buttons.forEach(button => {
        button.addEventListener('click', async () => {
            const res = await fetch('/create-checkout-session', {
                method: 'POST'
            });
            const data = await res.json();
            window.location.href = data.url;
        })
    })

</script>