<div class="container p-4">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <div class="card">
                <div class="card-body">
                    <form action="/links/edit_motivo/{{Data.id}}" method="POST">
                        <div class="form-group">
                            <label for="exampleFormControlTextarea1" class="form-label">Asunto del Folio</label>
                            <textarea class="form-control" type="password" name="motivo" rows="5">{{Data.motivo}}</textarea>
                        </div>
                        <div class="form-group mt-3">
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <input class="btn btn-primary" type="submit" value="Enviar a Revisión">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>