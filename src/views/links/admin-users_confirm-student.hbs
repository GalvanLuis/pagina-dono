<div class="row w-100">
    <div class="col-auto p-0 bg-light lsidebar">
        <ul class="nav nav-tabs flex-column mb-auto">
            {{#each adminSidebar}}
            <li class="nav-item">
                <a href={{this.link}} class="nav-link lsidebar-item {{this.active}}" aria-current="page">
                    <i class="{{this.icon}}"></i>
                    <div class="ms-3 lsidebar-tab text-truncate">{{@key}}</div>
                </a>
            </li>
            {{/each}}
        </ul>
    </div>

    <div class="col-6 mx-auto">
        <div class="container container-fluid ps-0 pt-4">
            <div class="card">
                <div class="card-body p-5" style="border-bottom: 0 !important">
                    <form action="add-alumno/{{userData.id_usuario}}" method="POST" class="was-validated">
                        <div class="row">
                            <div class="col-auto d-flex align-items-center" style="padding-bottom: 5rem!important;">
                                <img src="/img/guillermo.jpg" alt="" width="120" height="120"
                                    class="rounded-circle border border-dark" />
                            </div>
                            <div class="col">
                                <div class="row" style="font-size: 1.5rem;">
                                    <div class="col-6 pe-0">
                                        <div class="row">
                                            <div class="form-group pe-2 ps-2">
                                                <label class="form-label">
                                                    <b>Usuario</b>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group pe-2 ps-2">
                                                <label class="form-label">
                                                    {{userData.nombre}} {{userData.apellido}}
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 ps-0">
                                        <div class="row">
                                            <div class="form-group pe-2 ps-3">
                                                <label class="form-label">
                                                    <b>Correo Electrónico</b>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group pe-2 ps-3">
                                                <label class="form-label">
                                                    {{userData.correo_electronico}}
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-6 pe-4 pt-4">
                                        <div class="form-group p-2 ps-0">
                                            <label class="form-label" for="type_sub">
                                                <b>Tipo de Estudio</b>
                                            </label>
                                            <select class="form-select" name="type_sub" id="type_sub" required>
                                                <option value=""></option>
                                            </select>
                                            <div class="invalid-feedback">
                                                No puede ir vacio este campo
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 ps-0 pt-4">
                                        <div class="form-group ps-1 pt-2">
                                            <label class="form-label" for="emailValidation">
                                                <b>Tiempo de suscripción</b>
                                            </label>
                                            <select class="form-select" name="type_sub" id="type_sub" required>
                                                <option value=""></option>
                                            </select>
                                            <div class="invalid-feedback">
                                                No puede ir vacio este campo
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-auto me-auto"></div>
                                    <div class="col-auto pt-5">
                                        <button class="btn btn-primary">Aceptar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>

                    {{#if advancedUserData.usuario}}
                    {{> advanced_user_data}}
                    {{/if}}

                    {{#if advancedUserData.alumno}}
                    SOY UN ESTUDIANTE
                    {{/if}}
                </div>
            </div>
        </div>
    </div>
</div>


<script src="/js/left_sidebar.js" type="text/javascript"></script>