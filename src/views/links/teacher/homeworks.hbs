<div class="row w-100">
    {{> sidebar_teacher}}
    
    <div class="col p-0 pe-0" style="height:80vh;">
        <nav>
            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                <button class="nav-link active" id="nav-students-tab" data-bs-toggle="tab" data-bs-target="#nav-students" type="button" role="tab" aria-controls="nav-students" aria-selected="true">Alumnos</button>
                <button class="nav-link" id="nav-homeworks-tab" data-bs-toggle="tab" data-bs-target="#nav-homeworks" type="button" role="tab" aria-controls="nav-homeworks" aria-selected="false">Tareas</button>
                <button class="nav-link" id="nav-exams-tab" data-bs-toggle="tab" data-bs-target="#nav-exams" type="button" role="tab" aria-controls="nav-exams" aria-selected="false">Examenes</button>
            </div>
        </nav>
        
        <div class="tab-content" id="nav-tabContent">
            <!-- Tab for Students -->
            <div class="tab-pane fade show active" id="nav-students" role="tabpanel" aria-labelledby="nav-students-tab">
                <div class="container-fluid ps-0 pt-0">
                    <div class="ms-0 pe-5 ps-5" style="background-color: white;">
                        <div class="row">
                            <div class="container-header pt-4 pb-4">
                                <div class="row">
                                    <p class="h1 pe-3">Alumnos</p>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            {{#each usersData as |outerValue outerKey|}}
                            <div class="container-header pt-4 pb-4">
                                <div class="row">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover">
                                            <thead>
                                                <tr>
                                                    <th scope="col">ID</th>
                                                    <th scope="col">Nombre</th>
                                                    <th scope="col">Edad</th>
                                                    <th scope="col">eMail</th>
                                                    <th scope="col">Nivel</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {{#if outerValue}}
                                                <div class="row" id="{{outerKey}}">
                                                    {{#each outerValue}}
                                                    <tr data-bs-toggle="modal" data-bs-target="#showpaymentinfo">
                                                        <th scope="row">{{this.id_student}}</th>
                                                        <td>{{this.student_Name}}</td>
                                                        <td>{{this.student_age}}</td>
                                                        <td>{{this.student_email}}</td>
                                                        <td>{{this.student_grade}}</td>
                                                    </tr>
                                                    {{/each}}
                                                </div>
                                                {{/if}}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Tab for Homeworks -->
            <div class="tab-pane fade" id="nav-homeworks" role="tabpanel" aria-labelledby="nav-homeworks-tab">
                <div class="container-fluid ps-0 pt-0">
                    <div class="ms-0 pe-5 ps-5" style="background-color: white;">
                        <div class="row">
                            <div class="container-header pt-4 pb-4">
                                <div class="row">
                                    <div class="col-lg-6 col-md-4 col-sm-2">
                                        <p class="h1 pe-3">Tareas</p>
                                    </div>
                                    {{#each hwData as |outerValue outerKey|}}
                                    {{#if this}}
                                    <div class="col-lg-4 col-md-4"></div>
                                    <div class="col-lg-2 col-md-4">
                                        <div class="row" id="{{outerKey}}">
                                            <a href="{{../actualPage}}/add?hid={{hwData.id_homework}}" class="btn btn-primary w-100">
                                                <i class="bi bi-person-plus-fill pe-2"></i>Agregar {{@key}}
                                            </a>
                                        </div>
                                    </div>
                                    {{/if}}
                                    {{/each}}
                                </div>
                            </div>
                        </div>
                        {{#each hwData as |outerValue outerKey|}}
                        {{#if this}}
                        <div class="row" id="{{outerKey}}">
                            {{#each outerValue}}
                            <div class="col-lg-3 col-md-12 mb-4 user-container">
                                <a href="{{../../actualPage}}/evaluation?hid={{this.id_homework}}" style="text-decoration: none; color: inherit"> 
                                    <div class="card h-100 w-100 shadow-lg">
                                        <div class="card-header" style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                            <div class="text-center pt-3">
                                                <span class="h2">{{this.homework_name}}</span>
                                            </div>
                                        </div>
                                        <div class="card-body" style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                            <div class="text-center pt-3">
                                                <p class="h6"><strong>Descripción: </strong>{{this.homework_description}}</p>
                                            </div>
                                            <div class="text-center pt-3">
                                                <p class="h6"><strong>Costo: </strong>{{this.homework_due_date}}</p>
                                            </div>
                                            <div class="text-center pt-3">
                                                <p class="h6"><strong>Duración: </strong>{{this.homework_status}} meses</p>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <div class="row">
                            <div class="container pb-4">
                                <div class="row">
                                    <div class="col-12 col-md-7 col-lg-5 col-xl-4 mx-auto">
                                        <div class="card text-center">
                                            <div class="card-header" style="background-color: gray;">
                                                <i class="bi bi-person-square" style="color: white; font-size: 5rem;"></i>
                                                <p style="color:white; font-size: 1.3rem;">Lista de Tareas vacía</p>
                                            </div>
                                            <div class="card-body pt-2">
                                                <p style="font-family: 'Raleway', sans-serif;">
                                                    Aún no se ha inscrito ninguna tarea
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/if}}
                        {{/each}}
                    </div>
                </div>
            </div>

            <!-- Tab for Exams -->
            <div class="tab-pane fade" id="nav-exams" role="tabpanel" aria-labelledby="nav-exams-tab">
                <div class="container-fluid ps-0 pt-0">
                    <div class="ms-0 pe-5 ps-5" style="background-color: white;">
                        <div class="row">
                            <div class="container-header pt-4 pb-4">
                                <div class="row">
                                    <div class="col-lg-6 col-md-4 col-sm-2">
                                        <p class="h1 pe-3">Examenes</p>
                                    </div>
                                    {{#each examData as |outerValue outerKey|}}
                                    {{#if this}}
                                    <div class="col-lg-4 col-md-4"></div>
                                    <div class="col-lg-2 col-md-4">
                                        <div class="row" id="{{outerKey}}">
                                            <a href="{{../actualPage}}/add?hid={{examData.id_homework}}" class="btn btn-primary w-100">
                                                <i class="bi bi-person-plus-fill pe-2"></i>Agregar {{@key}}
                                            </a>
                                        </div>
                                    </div>
                                    {{/if}}
                                    {{/each}}
                                </div>
                            </div>
                        </div>
                        {{#each examData as |outerValue outerKey|}}
                        {{#if this}}
                        <div class="row" id="{{outerKey}}">
                            {{#each outerValue}}
                            <div class="col-lg-3 col-md-12 mb-4 user-container">
                                <a href="{{../../actualPage}}/evaluation?hid={{this.id_homework}}" style="text-decoration: none; color: inherit"> 
                                    <div class="card h-100 w-100 shadow-lg">
                                        <div class="card-header" style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                            <div class="text-center pt-3">
                                                <span class="h2">{{this.homework_name}}</span>
                                            </div>
                                        </div>
                                        <div class="card-body" style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                            <div class="text-center pt-3">
                                                <p class="h6"><strong>Examen de aula: </strong>{{this.id_exam}}</p>
                                            </div>
                                            <div class="text-center pt-3">
                                                <p class="h6"><strong>Fecha de entrega</strong>{{this.exam_due_date}}</p>
                                            </div>
                                            <div class="text-center pt-3">
                                                <p class="h6"><strong>Estatus: </strong>{{this.Exam_status}}</p>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <div class="row">
                            <div class="container pb-4">
                                <div class="row">
                                    <div class="col-12 col-md-7 col-lg-5 col-xl-4 mx-auto">
                                        <div class="card text-center">
                                            <div class="card-header" style="background-color: gray;">
                                                <i class="bi bi-person-square" style="color: white; font-size: 5rem;"></i>
                                                <p style="color:white; font-size: 1.3rem;">Lista de Tareas vacía</p>
                                            </div>
                                            <div class="card-body pt-2">
                                                <p style="font-family: 'Raleway', sans-serif;">
                                                    Aún no se ha inscrito ningun examen
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/if}}
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/left_sidebar.js" type="text/javascript"></script>
<script src="/js/admin_searchusers.js" type="text/javascript"></script>
