<div class="row w-100">
    {{> sidebar_teacher}}

    <div class="col-12 col-md-6 mx-auto">
        <div class="container container-fluid ps-0 pt-4">
            <div class="card">
                <div class="card-body p-4 p-md-5" style="border-bottom: 0 !important">
                    <form action="add-homework" method="POST" id="add-homework-form" class="was-validated">

                        <div class="row">
                            <div class="h4 pb-3 ps-0">
                                Revision de tarea
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 pe-0">
                                <div class="form-group p-2">
                                    <label class="form-label" for="status">
                                        <b>Estado de entrega</b>
                                        <span style="color: red;">*</span>
                                    </label>
                                    <select name="status" id="status" class="form-control" required>
                                        <option value="" disabled selected>Seleccione el estado</option>
                                        <option value="entregado">Entregado</option>
                                        <option value="no_entregado">No entregado</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        No puede ir vacio este campo
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 ps-0">
                                <div class="form-group p-2">
                                    <label class="form-label" for="additional-materials">
                                        <b>Calificacion</b>
                                    </label>
                                    <input name="grade" id="homework-grade" class="form-control"
                                        placeholder="Ingrese una calificacion">
                                    </input>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="form-group p-2">
                                    <label class="form-label" for="homework-description">
                                        <b>Retroalimentacion</b>
                                        <span style="color: red;">*</span>
                                    </label>
                                    <textarea name="feedbaack" id="homework-feedback" class="form-control"
                                        placeholder="Se sugiere escribir una retroalimentacion para mejorar el aprendizaje del alumno" rows="4"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-auto me-auto">
                                <button type="button" class="btn btn-danger" onclick="window.history.back();">
                                    Cancelar
                                </button>
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-primary">
                                    Agregar calificacion
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmCancel" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Confirmar Cancelación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que deseas cancelar la creación de esta tarea?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Sí</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin_add_plan.js" type="text/javascript"></script>
