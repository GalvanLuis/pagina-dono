<div class="row w-100">
    {{> sidebar_teacher}}
    
    <div class="col p-0 pe-0" style="height:80vh;">
        <nav>
            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                <button class="nav-link active" id="nav-students-tab" data-bs-toggle="tab" data-bs-target="#nav-students" type="button" role="tab" aria-controls="nav-students" aria-selected="true">Entrega de tareas</button>
            </div>
        </nav>
        <link rel="stylesheet" href="/css/teachers.css">
        <div class="tab-content" id="nav-tabContent">
            <div class="tab-pane fade show active" id="nav-students" role="tabpanel" aria-labelledby="nav-students-tab">
                <div class="container-fluid ps-0 pt-0">
                    <div class="ms-0 pe-5 ps-5" style="background-color: white;">
                        <div class="row">
                            <div class="container-header pt-4 pb-4">
                                <div class="row">
                                    {{#each hwTask as |outerValue outerKey|}}
                                        <div class="container-header pt-4 pb-4">
                                            {{#if this}}
                                            <div class="row" id="{{outerKey}}">
                                                {{#each outerValue}}
                                                    <div class="teacher-row">
                                                        <p class="h2 pe-3" title="{{this.homework_name}}">Tarea: {{truncate this.homework_name 20}}</p>
                                                        <p class="date h2 pe-3">Fecha de entrega: <span style="color: red;">{{truncate this.homework_due_date 20}}</span></p>
                                                    </div>
                                                    <div class="teacher-row" id="description">
                                                        <p class="h3 pe-3" title="{{this.homework_description}}">Descripción: {{truncate this.homework_description 20}}</p>
                                                {{/each}}
                                            </div>
                                            {{/if}}
                                        </div>
                                    {{/each}}
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="row">
                                <p class="h3 pe-3">Alumnos</p>
                            </div>
                            {{#each usersData as |outerValue outerKey|}}
                            <div class="container-header pt-4 pb-4">
                                <div class="row">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover">
                                            <thead>
                                                <tr>
                                                    <th scope="col">ID</th>
                                                    <th scope="col">Nombre</th>
                                                    <th scope="col">Fecha</th>
                                                    <th scope="col">Estatus</th>
                                                    <th scope="col">Calificacion</th>
                                                    <th scope="col">Tarea Adjunta</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {{#if outerValue}}
                                                    <div class="row" id="{{outerKey}}">
                                                        {{#each outerValue}}
                                                            <tr data-bs-toggle="modal" data-bs-target="#showpgradesinfo">
                                                                <th scope="row">
                                                                    <a href="{{../../actualPage}}/feedback?hid={{this.id_homework}}&uid={{this.id_student}}" style="text-decoration: none; color: inherit">{{this.id_student}}</a>
                                                                </th>
                                                                <td>
                                                                    <a href="{{../../actualPage}}/feedback?hid={{this.id_homework}}&uid={{this.id_student}}" style="text-decoration: none; color: inherit">{{this.student_Name}}</a>
                                                                </td>
                                                                <td>
                                                                    <a href="{{../../actualPage}}/feedback?hid={{this.id_homework}}&uid={{this.id_student}}" style="text-decoration: none; color: inherit">{{this.homework_delivered_date}}</a>
                                                                </td>
                                                                <td>
                                                                    <a href="{{../../actualPage}}/feedback?hid={{this.id_homework}}&uid={{this.id_student}}" style="text-decoration: none; color: inherit">{{this.homework_status}}</a>
                                                                </td>
                                                                <td>
                                                                    <a href="{{../../actualPage}}/feedback?hid={{this.id_homework}}&uid={{this.id_student}}" style="text-decoration: none; color: inherit">{{this.homework_grade}}</a>
                                                                </td>
                                                                <td>
                                                                    <a href="{{this.homework_link}}" target="_blank" style="text-decoration: none; color: inherit" data-bs-toggle="tooltip" data-bs-placement="top" title="{{this.homework_link}}">
                                                                        <i class="bi bi-paperclip"></i>
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                        {{/each}}
                                                    </div>
                                                {{/if}}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/left_sidebar.js" type="text/javascript"></script>
<script src="/js/admin_searchusers.js" type="text/javascript"></script>