    <div class="row w-100">
        {{> sidebar_teacher}}

        <div class="col p-0 pe-0" style="height:80vh;">
            <nav>
                <div class="nav nav-tabs" id="nav-tab" role="tablist">
                    {{#each usersData as |outerValue outerKey|}}
                        {{#if @first}}
                            <button class="nav-link active" id="nav-{{@key}}-tab" data-bs-toggle="tab" data-bs-target="#nav-{{@key}}" type="button" role="tab" aria-controls="nav-{{@key}}" aria-selected="true">{{@key}}</button>
                        {{else}}
                            <button class="nav-link" id="nav-{{@key}}-tab" data-bs-toggle="tab" data-bs-target="#nav-{{@key}}" type="button" role="tab" aria-controls="nav-{{@key}}" aria-selected="true">{{@key}}</button>
                        {{/if}}
                    {{/each}}
                </div>
            </nav>

            <div class="tab-content" id="nav-tabContent">
                {{#each usersData as |outerValue outerKey|}}
                    {{#if @first}}
                        <div class="tab-pane fade show active" id="nav-{{@key}}" role="tabpanel" aria-labelledby="nav-{{@key}}-tab">
                    {{else}}
                        <div class="tab-pane fade" id="nav-{{@key}}" role="tabpanel" aria-labelledby="nav-{{@key}}-tab">
                    {{/if}}

                    <div class="container-fluid ps-0 pt-0">
                        <div class="ms-0 ps-5 pe-5" style="background-color: white;">
                            <div class="row">
                                <div class="container-header pt-4 pb-4">
                                    <div class="row">
                                        <div class="col-lg-10 col-md-6 col-sm-4">
                                            <p class="h1 pe-3"> Salones del plan {{@key}}: </p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {{#if this}}
                                <div class="row" id="{{outerKey}}">
                                    {{#each outerValue}}
                                        <div class="col-lg-3 col-md-12 mb-4 user-container">
                                            <a href="{{../../actualPage}}/homeworks?ct={{this.id_tipo_plan}}&id={{this.id_classroom}}" style="text-decoration: none; color: inherit">
                                                <div class="card h-100 w-100 shadow-lg">
                                                    <div class="card-header" style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                                        <div class="text-center pt-3">
                                                            <span class="h2">{{this.classroom_name}}</span>
                                                        </div>
                                                    </div>
                                                    <div class="card-body" style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                                        <div class="text-center pt-3">
                                                            <span class="h5"><strong>Numero de Alumnos:</strong> {{this.student_number}}</span>
                                                        </div>
                                                        <div class="text-center pt-3">
                                                            <span class="h5"><strong>Progreso del curso: </strong></span>
                                                            <div class="progress">
                                                                <div class="progress-bar progress-bar-animated" role="progressbar" style="width: {{this.classroom_progress}}%;" aria-valuenow="{{this.classroom_progress}}" aria-valuemin="0" aria-valuemax="100"> {{this.classroom_progress}}%</div>
                                                            </div>
                                                        </div>  
                                                    </div>
                                                    <div class="card-footer" style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                                        <div class="text-center pt-3">
                                                            <span class="h4"><strong>Horario:</strong> {{this.classroom_schedule}}</span>
                                                        </div>
                                                        <div class="text-center pt-3">
                                                            <a href="#" class="h4"><strong>Lugar:</strong> {{this.classroom_location}}</a>    
                                                        </div> 
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    {{/each}}
                                </div>
                            {{else}}
                                <div class="row">
                                    <div class="container pb-4">
                                        <div class="row">
                                            <div class="col-12 col-md-7 col-lg-5 col-xl-4 mx-auto">
                                                <div class="card text-center">
                                                    <div class="card-header" style="background-color: gray;">
                                                        <i class="bi bi-easel" style="color: white; font-size: 5rem;"></i>
                                                        <p style="color:white; font-size: 1.3rem;">Salones en el plan {{@key}}</p>
                                                    </div>
                                                    <div class="card-body pt-2">
                                                        <p style="font-family: 'Raleway', sans-serif;">
                                                            No tienes ningun salon en el plan {{@key}}
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {{/if}}
                        </div>
                    </div>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>

    <script src="/js/left_sidebar.js" type="text/javascript"></script>
