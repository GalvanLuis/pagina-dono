<div class="container p-4">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-tittle">
                        Motivo del Folio:
                    </h5>
                    
                    <p class="card-text">{{motivo}}</p>

                    <hr>
                    <form action="/links/edit_folio/{{id}}" method="POST">
                        <div class="form-group">
                            <label for="exampleFormControlTextarea1" class="form-label"><h5>Observaciones de la Solicitud</h5></label>
                            <textarea class="form-control" type="password" name="respuesta" rows="5"></textarea>
                        </div>
                        <div class="form-group mt-3">
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <input class="btn btn-primary" type="submit" value="Enviar observaciones">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>