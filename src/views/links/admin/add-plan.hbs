<div class="row w-100">
    {{> sidebar_admin}}

    <div class="col-6 mx-auto">
        <div class="container container-fluid ps-0 pt-4">
            <div class="card">
                <div class="card-body p-5" style="border-bottom: 0 !important">
                    <form action="add-plans" method="POST" id="add-plans-form" class="was-validated">

                        <div class="row">
                            <div class="h4 pb-3 ps-0">
                                Agregar un nuevo plan
                            </div>
                        </div>

                        <div class="row">
                            <div class="col">
                                <div class="row">
                                    <div class="col-6 pe-0">
                                        <div class="form-group p-2">
                                            <label class="form-label" for="nameValidation">
                                                <b>Nombre del plan</b>
                                                <span style="color: red;">*</span>
                                            </label>
                                            <input type="text" name="name" id="nameValidation" placeholder="Nombre del plan (obligatorio)"
                                                class="form-control" required>
                                            <div class="invalid-feedback">
                                                No puede ir vacio este campo
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 ps-0">
                                        <div class="form-group p-2">
                                            <label class="form-label" for="dateValidation">
                                                <b>Fecha</b>    
                                            </label>
                                            <input type="date" name="date" id="dateValidation" class="form-control">
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-6 pe-0">
                                        <div class="form-group p-2">
                                            <label class="form-label" for="plan-description">
                                                <b>Descripción del plan</b>
                                            </label>
                                            <input type="text" name="description" id="plan-description" class="form-control"
                                                placeholder="Ingrese una descripción (opcional)">
                                        </div>
                                    </div>

                                    <div class="col-6 ps-0">
                                        <div class="form-group p-2">
                                            <label class="form-label" for="plan-cost">
                                                <b>Costo del plan</b>
                                                <span style="color: red;">*</span>
                                            </label>
                                            <input type="number" name="cost" id="plan-cost" class="form-control"
                                                placeholder="Ingrese el costo del plan (obligatorio)" required>
                                            <div class="invalid-feedback">
                                                No puede ir vacio este campo
                                            </div>
                                        </div>
                                    </div>  
                                </div>
                                <div class="row">
                                    <div class="col-6 pe-0">
                                        <div class="form-group p-2">
                                            <label class="form-label" for="plan-duration">
                                                <b>Duración del plan</b>
                                                <span style="color: red;">*</span>
                                            </label>
                                            <input type="number" name="duration" id="plan-duration" class="form-control"
                                                placeholder="Ingrese la duración del plan (obligatorio)" required>
                                            <div class="invalid-feedback">
                                                No puede ir vacio este campo
                                            </div>  
                                        </div>
                                    </div>
                                    <div class="col-6 ps-0">
                                        <div class="form-group p-2">
                                            <label class="form-label" for="plan-activated">
                                                <b>Estatus del plan</b>
                                                <span style="color: red;">*</span>
                                            </label>
                                            <div class="form-check">
                                                <input type="checkbox" name="isActivated" id="plan-activated" class="form-check-input">
                                                <label class="form-check-label" for="plan-activated">Activado</label>
                                            </div>
                                        </div>
                                    </div>
                                   <div class="col-auto me-auto">
                                        <button type="button" class="btn btn-danger" onclick="window.history.back();">
                                            Cancelar
                                        </button>
                                    </div>
                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-primary">
                                            Agregar plan
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmCancel" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Confirmar Cancelación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que deseas cancelar la creación de este plan?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Sí</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin_add_plan.js" type="text/javascript"></script>
