<div class="row w-100">
    {{> sidebar_admin}}

    <div class="col p-0 pe-0" style="height:80vh;">
        <nav>
            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                {{#each usersData as |outerValue outerKey|}}
                {{#if @first}}
                <button class="nav-link active" id="nav-{{@key}}-tab" data-bs-toggle="tab" data-bs-target="#nav-{{@key}}" type="button" role="tab" aria-controls="nav-{{@key}}" aria-selected="true">{{@key}}</button>
                {{else}}
                <button class="nav-link" id="nav-{{@key}}-tab" data-bs-toggle="tab" data-bs-target="#nav-{{@key}}" type="button" role="tab" aria-controls="nav-{{@key}}" aria-selected="true">{{@key}}</button>
                {{/if}}
                {{/each}}
            </div>
        </nav>
        
        <div class="tab-content" id="nav-tabContent" >
            {{#each usersData as |outerValue outerKey|}}

            {{#if @first}}
            <div class="tab-pane fade show active" id="nav-{{@key}}" role="tabpanel" aria-labelledby="nav-{{@key}}-tab">
            {{else}}
            <div class="tab-pane fade" id="nav-{{@key}}" role="tabpanel" aria-labelledby="nav-{{@key}}-tab">
            {{/if}}

                <div class="container-fluid ps-0 pt-0">
                    <div class="ms-0 pe-5 ps-5" style="background-color: white;">
                        <div class="row">
                            <div class="container-header pt-4 pb-4">
                                <div class="row">
                                    <div class="col-lg-6 col-md-4 col-sm-2">
                                        <p class="h1 pe-3">Lista de planes creados: </p>
                                    </div>
                                    <div class="col-lg-4 col-md-4"></div>
                                    <div class="col-lg-2 col-md-4">
                                        <a href="{{../actualPage}}/add?pt={{plans_to_id @key}}" class="btn btn-primary w-100">
                                            <i class="bi bi-person-plus-fill pe-2"></i>Agregar {{@key}}
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {{#if this}}
                        <div class="row" id="{{outerKey}}">
                            {{#each outerValue}}
                            <div class="col-lg-3 col-md-12 mb-4 user-container">
                                <a href="{{../../actualPage}}/edit?id={{this.id_plan}}&pt={{this.id_tipo_plan}}" style="text-decoration: none; color: inherit"> 
                                    <div class="card h-100 w-100 shadow-lg">
                                        <div class="card-header"
                                            style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                            <div class="text-center pt-3">
                                                <span class="h2">{{this.name}}</span>
                                            </div>
                                        </div>
                                        <div class="card-body"
                                            style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                                <div class="text-center pt-3">
                                                    <p class="h6"><strong>Descripción: </strong>{{this.description}}</p>
                                                </div>
                                                <div class="text-center pt-3">
                                                    <p class="h6"><strong>Costo: </strong>{{this.price}}</p>
                                                </div>
                                                <div class="text-center pt-3">
                                                    <p class="h6"><strong>Duración: </strong>{{this.duration}} meses     </p>
                                                </div>
                                        </div>
                                        <div class="d-flex card-footer text-center pb-3 w-100 h-100 align-items-end"
                                            style="background-color: rgb(237, 237, 237); border-top: 0 !important">
                                            <div class="text-center pt-3">
                                                {{#if this.is_activated}}
                                                Estatus:
                                                <i class="bi bi-check-circle-fill" style="color: green; font-size: 1.5rem;"></i>
                                                {{else}}
                                                Estatus:
                                                <i class="bi bi-x-circle-fill" style="color: red; font-size: 1.5rem;"></i>
                                                {{/if}}
                                            </div>
                                            <div class="text-center pt-3">
                                                <p class="h5"><strong>Fecha de creación: </strong> {{this.date}}</p>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <div class="row">
                            <div class="container pb-4">
                                <div class="row">
                                    <div class="col-12 col-md-7 col-lg-5 col-xl-4 mx-auto">
                                        <div class="card text-center">
                                            <div class="card-header" style="background-color: gray;">
                                                <i class="bi bi-person-square" style="color: white; font-size: 5rem;"></i>
                                                <p style="color:white; font-size: 1.3rem;">Lista de {{@key}}s vacía</p>
                                            </div>
                                            <div class="card-body pt-2">
                                                <p style="font-family: 'Raleway', sans-serif;">
                                                    Aún no se ha inscrito ningun {{@key}}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/if}}
                    </div>
                </div>



            </div>                
            {{/each}}
        </div>
    </div>
</div>

<script src="/js/left_sidebar.js" type="text/javascript"></script>
<script src="/js/admin_searchusers.js" type="text/javascript"></script>