<div class="row w-100">
    {{> sidebar}}

    <div class="col-6 mx-auto">
        <div class="container container-fluid ps-0 pt-4">
            <div class="card">
                <div class="card pt-5"></div>
                    {{#each usersdata.this}}
                        <div class="card-body">
                            <h5 class="card-title"></h5>
                            <p class="card-text">{{this.description}}</p>
                        </div>
                    {{/each}}
                </div>
            </div>
        </div>
    </div>
</div>

