<div class="row w-100">
    {{> sidebar}}
    
    <div class="col p-0 pe-0" style="height:80vh;">
        <nav>
            <div class="nav nav-tabs" id="nav-tab" role="tablist">
                {{#each usersData as |outerValue outerKey|}}
                    {{#if @first}}
                        <button class="nav-link active" id="nav-{{@key}}-tab" data-bs-toggle="tab" data-bs-target="#nav-{{@key}}" type="button" role="tab" aria-controls="nav-{{@key}}" aria-selected="true">{{@key}}</button>
                    {{else}}
                        <button class="nav-link" id="nav-{{@key}}-tab" data-bs-toggle="tab" data-bs-target="#nav-{{@key}}" type="button" role="tab" aria-controls="nav-{{@key}}" aria-selected="true">{{@key}}</button>
                    {{/if}}
                {{/each}}
            </div>
        </nav>
        
        <div class="tab-content" id="nav-tabContent" >
            {{#each usersData as |outerValue outerKey|}}
            
                {{#if @first}}
                    <div class="tab-pane fade show active" id="nav-{{@key}}" role="tabpanel" aria-labelledby="nav-{{@key}}-tab">
                {{else}}
                    <div class="tab-pane fade" id="nav-{{@key}}" role="tabpanel" aria-labelledby="nav-{{@key}}-tab">
                {{/if}}
                    <div class="container-fluid ps-0 pt-0">
                        <div class="ms-0 pe-5 ps-5" style="background-color: white;">
                            <div class="row">
                                <div class="container-header pt-4 pb-4">
                                    <div class="row">
                                        <p class="h1 pe-3">{{@key}}</p>
                                    </div>
                                    <div class="row">
                                        <div class="col      d-flex align-items-center h-100 me-auto pe-0 " style="background-color: #e7e7e7;margin-left: 0.7rem !important;">
                                            <i class="bi bi-search pe-1"></i>
                                            <input class="form-control" type="text" id="searchInput-{{@key}}" oninput="searchUser('{{@key}}')" placeholder="Buscar {{@key}}" style="background-color: #e7e7e7; border-radius: 0; border-width: 0;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {{#if this}}
                                <div class="container-header pt-4 pb-4">
                                    <div class="row">
                                        <div class="table-responsive">
                                            <table class="table table-striped table-hover">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">ID del pago</th>
                                                        <th scope="col">Estudiante</th>
                                                        <th scope="col">Plan</th>
                                                        <th scope="col">Salon</th>
                                                        <th scope="col">Fecha de pago</th>
                                                        <th scope="col">Monto</th>
                                                        </tr>
                                                </thead>
                                                <tbody>
                                                {{#if outerValue}}
                                                    <div class="row" id="{{outerKey}}">
                                                        {{#each outerValue}}
                                                            <tr data-bs-toggle="modal" data-bs-target="showpaymentifo">
                                                                <th scope="row">{{this.id_payment}}</th>
                                                                <td>{{this.student_Name}}</td>
                                                                <td>{{this.id_tipo_plan}}</td>
                                                                <td>{{this.id_classroom}}</td>
                                                                <td>{{this.payment_Date}}</td>
                                                                <td>{{this.payment}}</td>
                                                            </tr>
                                                        {{/each}}
                                                    </div>
                                                {{/if}}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            {{else}}
                            {{/if}}
                        </div>
                    </div>
                </div>
            {{/each}}
        </div>
    </div>
</div>

<script src="/js/left_sidebar.js" type="text/javascript"></script>
<script src="/js/admin_searchusers.js" type="text/javascript"></script>
