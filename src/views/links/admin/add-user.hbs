<div class="row w-100">
    {{> sidebar}}

    <div class="col-auto mx-auto">
        <div class="container p-4">
            <div class="card text-center signup">
                <div class="card-header">
                    Favor de rellenar todos los campos
                </div>
                <div class="card-body">

                    <form action="add-usuario/" method="POST" id="singup-form" class="needs-validation" novalidate>
                        <div class="row">
                            <div class="col-6 pe-0">
                                <div class="form-group p-2">
                                    <label class="form-label" for="nameValidation">
                                        <b>Nombre(s)</b>
                                        <span style="color: red;">*</span>
                                    </label>
                                    <input type="text" name="name" id="nameValidation" placeholder="Nombre(s)"
                                        class="form-control" autofocus required>
                                    <div class="invalid-feedback">
                                        No puede ir vacio este campo
                                    </div>
                                </div>
                            </div>
                            <div class="col-6 ps-0">
                                <div class="form-group p-2">
                                    <label class="form-label" for="lastnameValidation">
                                        <b>Apellido(s)</b>
                                        <span style="color: red;">*</span>
                                    </label>
                                    <input type="text" name="last_name" id="lastnameValidation"
                                        placeholder="Apellido(s)" class="form-control" required>
                                    <div class="invalid-feedback">
                                        No puede ir vacio este campo
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col pe-0">
                                <div class="form-group p-2">
                                    <label class="form-label"><b>Número de Telefono</b> <span
                                            style="color: red;">*</span></label>
                                    <input type="tel" id="sup-phone-number" name="num_phone" class="form-control"
                                        pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" placeholder="123-456-7890" maxlength="12"
                                        required>
                                    <div class="invalid-feedback">
                                        No puede ir vacio este campo
                                    </div>
                                </div>
                            </div>
                            <div class="col ps-0">
                                <div class="form-group p-2">
                                    <label class="form-label"><b>Correo Electrónico</b> <span
                                            style="color: red;">*</span></label>
                                    <input type="email" name="email" placeholder="Correo Electrónico"
                                        pattern="^(?!.*\.\.)[a-zA-Z._%]+[a-zA-Z0-9.]{0,}@[a-zA-Z.]+\.[a-zA-Z]+"
                                        class="form-control" required>
                                    <div class="invalid-feedback">
                                        Correro electrónico no valido
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group p-2">
                            <label class="form-label"><b>Contraseña</b> <span style="color: red;">*</span></label>
                            <input type="password" id="pass" name="pass" placeholder="Contraseña" class="form-control"
                                required>
                            <div class="invalid-feedback">
                                No puede ir vacio este campo
                            </div>
                        </div>
                        <div class="form-group p-2">
                            <label class="form-label"><b>Repetir Contraseña</b> <span
                                    style="color: red;">*</span></label>
                            <input type="password" id="rpass" name="rpass" placeholder="Contraseña" class="form-control"
                                required>
                            <div class="invalid-feedback">
                                No puede ir vacio este campo
                            </div>
                        </div>

                        <div class="form-group p-2">
                            <div class="d-grid">
                                <button class="btn btn-success" type="submit">Enviar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/left_sidebar.js" type="text/javascript"></script>
<script src="/js/admin_add_user.js" type="text/javascript"></script>