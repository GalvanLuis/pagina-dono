<div class="row w-100">
    <div class="col-auto p-0 bg-light lsidebar">
        <ul class="nav nav-tabs flex-column mb-auto">
            {{#each adminSidebar}}
            <li class="nav-item">
                <a href={{this.link}} class="nav-link lsidebar-item {{this.active}}" aria-current="page">
                    <i class="{{this.icon}}"></i>
                    <div class="ms-3 lsidebar-tab text-truncate">{{@key}}</div>
                </a>
            </li>
            {{/each}}
        </ul>
    </div>

    <div class="col p-0 pe-5">
        <div class="row pt-4">
            <div class="col d-flex me-auto">
            </div>
            <div class="col-auto ms-auto">
                <div class="row">
                    {{#if type_subscriptions}}
                    <div class="col">
                        <select name="filterTypePlanb" id="filterTypePlan" class="form-select">
                            {{#each type_subscriptions}}
                            <option value="{{id_tipo_suscripcion}}">{{nombre_suscripcion}}</option>
                            {{/each}}
                        </select>
                    </div>
                    {{/if}}
                    <div class="col">
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal"
                            data-bs-target="#confirmAddSubscription" style="white-space: nowrap;">
                            Agregar Suscripción
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            {{#each typeSubscriptions as |typeSubID typeSub|}}
            <div class="container-fluid ps-0 pt-4">
                <div class="ms-0 pe-5 ps-5" style="background-color: white;">

                    <div class="row">
                        <div class="container-header pt-5 pb-4">
                            <div class="row">
                                <p class="h1 pe-3">Plan {{nombre_suscripcion}}</p>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-3 col-md-12 mb-4">
                            <a href="admin-plans/add-plan/{{id_tipo_suscripcion}}"
                                style="color:inherit; text-decoration: none;">
                                <div class="card h-100 w-100 shadow-lg">
                                    <div class="card-header">
                                        <div class="text-center pt-3 pb-3">
                                            <i class="bi bi-plus-circle" style="font-size: 4rem;"></i>
                                            <p style="font-size: 1.3rem;">Agregar nuevo plan {{nombre_suscripcion}}</p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>

                    {{#each ../plans as |planID planData|}}
                    <div class="container-plans">
                        <div class="container-fluid">
                            <div class="container p-5">
                                <div class="text-center opensans"
                                    style="margin-top: 2vw;padding-bottom: 2vw; color: #0b375ad9;">
                                    <h2>
                                        {{@key}}
                                    </h2>
                                </div>
                                <div class="row">
                                    {{#each this}}
                                    <div class="col-lg-4 col-md-12 mb-4">
                                        <div class="card h-100 w-100 shadow-lg">
                                            <div class="card-header {{css-clase}}">
                                                <div class="text-center pt-3">
                                                    <span class="h2">${{precio}}</span>/{{re_write_month meses}}
                                                </div>
                                            </div>
                                            <div class="card-body ps-5 pe-5">
                                                <ul class="list-group list-group-flush">
                                                    {{#each beneficios}}
                                                    <li class="list-group-item ps-0 pe-0">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                            fill="currentColor" class="bi bi-check" viewBox="0 0 16 16">
                                                            <path
                                                                d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z" />
                                                        </svg> {{this}}
                                                    </li>
                                                    {{/each}}
                                                </ul>
                                            </div>
                                            <div class="card-footer text-center">
                                                {{!-- <form action="#" method="POST">
                                                    <input type="hidden" name="precio" value="{{precio}}">
                                                    <button
                                                        class="btn btn-outline btn-{{css-clase}} w-100">Comprar</button>
                                                </form> --}}
                                                {{!-- <a href="{{link}}"
                                                    class="btn btn-outline btn-{{css-clase}} w-100">Comprar</a> --}}
                                                <button
                                                    class="btn btn-outline btn-{{css-clase}} w-100 btn-pay">Comprar</button>
                                            </div>
                                        </div>
                                    </div>
                                    {{/each}}
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}

                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>

<div class="modal fade" id="confirmAddSubscription" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Nueva Suscripción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="admin-plans/add-subscription" class="needs-validation" method="post">
                <div class="modal-body">
                    <div class="form-group">
                        <b>Nombre:</b>
                        <input type="text" name="name_subscription" class="form-control" required>
                        <div class="invalid-feedback">
                            No puede ir vacio este campo
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submmit" class="btn btn-primary">Aceptar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/js/left_sidebar.js" type="text/javascript"></script>