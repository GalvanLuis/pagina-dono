<div class="row w-100">
    <div class="col-auto p-0 bg-light lsidebar">
        <ul class="nav nav-tabs flex-column mb-auto">
            {{#each adminSidebar}}
            <li class="nav-item">
                <a href={{this.link}} class="nav-link lsidebar-item {{this.active}}" aria-current="page">
                    <i class="{{this.icon}}"></i>
                    <div class="ms-3 lsidebar-tab text-truncate">{{@key}}</div>
                </a>
            </li>
            {{/each}}
        </ul>
    </div>
    <div class="col p-0 pe-5">
        {{#each userData as |outerValue outerKey|}}
        <div class="container-fluid ps-0 pt-4" style="max-height: 28.5%; overflow-y: auto;">
            <div class="ms-0 pe-5 ps-5" style="background-color: white;">
                <div class="row">
                    <div class="container-header pt-5 pb-4">
                        <div class="row">
                            <p class="h1 pe-3">{{@key}}</p>
                        </div>
                        <div class="row">
                            <div class="col-6 d-flex align-items-center h-100 me-auto pe-0"
                                style="background-color: #e7e7e7;margin-left: 0.7rem !important;">
                                <i class="bi bi-search pe-1"></i>
                                <input class="form-control" type="text" id="searchInput-{{@key}}"
                                    oninput="searchUser('{{@key}}')" placeholder="Buscar {{@key}}"
                                    style="background-color: #e7e7e7; border-radius: 0; border-width: 0;">
                            </div>

                            <div class="col-2">
                                <a href="admin-users/add-{{to_lower_case @key}}" class="btn btn-primary w-100">
                                    <i class="bi bi-person-plus-fill pe-2"></i>
                                    Agregar {{@key}}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                {{#if this}}
                <div class="row" id="{{outerKey}}">
                    {{#each outerValue}}
                    <div class="col-lg-3 col-md-12 mb-4 user-container">
                        <a href="admin-users/edit-user?id={{this.id_usuario}}"
                            style="text-decoration: none; color: inherit">
                            <div class="card h-100 w-100 shadow-lg">
                                <div class="card-header"
                                    style="background-color: rgb(237, 237, 237); border-bottom: 0 !important">
                                    <div class="text-center">
                                        <img src="/img/guillermo.jpg" alt="" width="120" height="120"
                                            class="rounded-circle border border-dark" />
                                    </div>
                                    <div class="text-center pt-3">
                                        <span class="h2">{{this.nombre}} {{this.apellido}}</span>
                                        <p style="color: #4e84e0;">{{this.correo_electronico}}</p>
                                    </div>
                                </div>
                                <div class="d-flex card-footer text-center pb-3 w-100 h-100 align-items-end"
                                    style="background-color: rgb(237, 237, 237); border-top: 0 !important">
                                    <p class="h5 mx-auto">Se unió el {{date_ this.fecha_creado}}</p>
                                </div>
                            </div>
                        </a>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <div class="row">
                    <div class="container pb-4">
                        <div class="row">
                            <div class="col-12 col-md-7 col-lg-5 col-xl-4 mx-auto">
                                <div class="card text-center">
                                    <div class="card-header" style="background-color: gray;">
                                        <i class="bi bi-person-square" style="color: white; font-size: 5rem;"></i>
                                        <p style="color:white; font-size: 1.3rem;">Lista de {{@key}}s vacía</p>
                                    </div>
                                    <div class="card-body pt-2">
                                        <p style="font-family: 'Raleway', sans-serif;">
                                            Aún no se ha inscrito ningun {{@key}}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
        {{/each}}
    </div>
</div>

<script src="/js/left_sidebar.js" type="text/javascript"></script>
<script src="/js/admin_searchusers.js" type="text/javascript"></script>