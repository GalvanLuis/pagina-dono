<div class="container p-4">
    <div class="row">
        <div class="col-md-10 mx-auto">
            <div class="card">
                <div class="card-body">
                    <p class="card-text" style="font-size: 20px;">
                        <strong style="font-size: 25px;">Area:</strong>
                        {{area}}
                    </p>

                    <p class="card-text" style="font-size: 20px;">
                        <strong style="font-size: 25px;">Fecha de la solicitud:</strong>
                        {{date_ fecha_solicitado}}
                    </p>

                    <p class="card-text" style="font-size: 20px;">
                        <strong style="font-size: 25px;">Fecha de rechazo:</strong>
                        {{date_ fecha_rechazado}}
                    </p>

                    <p class="card-text" style="font-size: 20px;">
                        <strong style="font-size: 25px;">Motivo:</strong>
                        {{motivo}}
                    </p>

                    <p class="card-text" style="font-size: 20px;">
                        <strong style="font-size: 25px;">Motivo por el que se rechazó:</strong>
                        {{observacion}}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>