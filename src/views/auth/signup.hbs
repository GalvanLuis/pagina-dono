<div class="container p-4">
    <div class="row">
        <div class="col-lg-6">
            <img src="/img/slider2.jpg" class="img-fluid w-100 h-100">
        </div>
        <div class="col-lg-6 col-12">
            <div class="card text-center signup">
                <div class="card-body">
                    <form action="/signup" method="POST" id="singup-form" onsubmit="return checkCaptcha(this)">
                        <div class="row">
                            <div class="col-6 pe-0">
                                <div class="form-group p-2">
                                    <label class="form-label"><b>Nombre(s)</b> <span style="color: red;">*</span></label>
                                    <input type="text" name="name" placeholder="Nombre(s)" class="form-control" autofocus required>
                                </div>
                            </div>
                            <div class="col-6 ps-0">
                                <div class="form-group p-2">
                                    <label class="form-label"><b>Apellido(s)</b> <span style="color: red;">*</span></label>
                                    <input type="text" name="last_name" placeholder="Apellido(s)" class="form-control" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-group p-2">
                            <label class="form-label"><b>Número de Telefono</b> <span style="color: red;">*</span></label>
                            <input type="tel" id="sup-phone-number" name="num_phone" class="form-control" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" placeholder="123-456-7890" maxlength="12" required>
                        </div>
                        <div class="form-group p-2">
                            <label class="form-label"><b>Correo Electrónico</b> <span style="color: red;">*</span></label>
                            <input type="email" name="email" placeholder="Correo Electrónico" class="form-control" required>
                        </div>
                        <div class="form-group p-2">
                            <label class="form-label"><b>Contraseña</b> <span style="color: red;">*</span></label>
                            <input type="password" id="pass" name="pass" placeholder="Contraseña" class="form-control" required>
                        </div>
                        <div class="form-group p-2">
                            <label class="form-label"><b>Repetir Contraseña</b> <span style="color: red;">*</span></label>
                            <input type="password" id="rpass" name="rpass" placeholder="Contraseña" class="form-control" required>
                        </div>
                        <div class="form-check ms-2">
                            <input class="form-check-input" type="checkbox"  name="terms" value="1" id="terms" required>
                            <label class="form-check-label" for="terms">
                                He leído y acepto la política de privacidad <span style="color: red;">*</span>
                            </label>
                        </div>
                        <div class="g-recaptcha ps-2" data-sitekey="6Lc0YPYlAAAAAGU8qbmA1o9xPFeyPvMD7pC0ohyo"></div>
                        <div id="captcha-error" class="ps-2" style="color: red;"></div>
                        <div class="form-group p-2">
                            <div class="d-grid">
                                <button class="btn btn-success">Enviar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>