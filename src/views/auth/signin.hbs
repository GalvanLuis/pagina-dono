<div class="container" style="padding-top: 5.5rem;">
    <div class="row">
        <div class="col-12 col-md-7 col-lg-5 col-xl-4 mx-auto">
            <div class="card text-center signin">
                <div class="card-body">
                    <form action="/signin" method="POST" onsubmit="return checkCaptcha(this)">
                        <div class="form-group p-2">
                            <label class="form-label"><b>Correo Electrónico</b></label>
                            <input type="email" name="email" placeholder="Correo Electrónico" class="form-control" required>
                        </div>
                        <div class="form-group p-2">
                            <label class="form-label"><b>Contraseña</b></label>
                            <input type="password" name="pass" placeholder="Contraseña" class="form-control" required>
                            <label class="form-label pt-2 mb-0"><a href=""><b>¿Has olvidado tu contraseña?</b></a></label>
                        </div>
                        <div class="g-recaptcha ps-2" data-sitekey="6Lc0YPYlAAAAAGU8qbmA1o9xPFeyPvMD7pC0ohyo"></div>
                        <div id="captcha-error" class="ps-2" style="color: red;"></div>
                        <div class="form-group p-2 pb-0">
                            <div class="d-flex justify-content-center">
                                <button class="btn btn-success rounded-pill w-100">Enviar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>